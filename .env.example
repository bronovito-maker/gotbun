# n8n production/test webhook URL. Leave empty for local demo mode.
N8N_WEBHOOK_URL="https://primary-production-b2af.up.railway.app/webhook/gotbun-coupon"

# n8n redemption webhook URL used inside the QR code shown at the register.
N8N_REDEEM_WEBHOOK_URL="https://primary-production-b2af.up.railway.app/webhook/gotbun-redeem"

# Optional QR image generator base URL. The app appends ?data=<redeem-url>.
# Leave empty to use https://api.qrserver.com/v1/create-qr-code/?size=420x420&data=...
QR_IMAGE_BASE_URL=""

# Admin Panel settings (Supabase Auth)
# Comma-separated allowlist of admin emails. Leave empty to allow any authenticated user (not recommended).
ADMIN_EMAILS="admin@gotbunriccione.it"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_MENU_IMAGES_BUCKET="menu-images"
