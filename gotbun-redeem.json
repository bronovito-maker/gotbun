    {
      "parameters": {
        "jsCode": "const record = $input.first()?.json || {};\nconst request = $('Normalize Redeem Request').first().json;\n\nfunction field(name, fallback = '') {\n  return record[name] ?? record.fields?.[name] ?? fallback;\n}\n\nconst now = new Date();\nconst expiresAtRaw = field('Expires At');\nconst expiresAt = expiresAtRaw ? new Date(expiresAtRaw) : null;\nconst status = String(field('Status', 'Active') || 'Active');\nconst redeemAttempts = Number(field('Redeem Attempts', 0) || 0);\n\nconst parts = new Intl.DateTimeFormat('en-GB', {\n  timeZone: 'Europe/Rome',\n  weekday: 'short',\n  hour: '2-digit',\n  minute: '2-digit',\n  hour12: false,\n}).formatToParts(now);\nconst weekday = parts.find((part) => part.type === 'weekday')?.value || '';\nconst hour = Number(parts.find((part) => part.type === 'hour')?.value || 0);\nconst minute = Number(parts.find((part) => part.type === 'minute')?.value || 0);\nconst minutesNow = hour * 60 + minute;\nconst isPromoDay = ['Mon', 'Tue', 'Wed', 'Thu'].includes(weekday);\nconst isPromoHour = minutesNow >= (18 * 60 + 30) && minutesNow <= (22 * 60 + 30);\nconst allowOutsidePromoForTest = false;\nconst storedToken = String(field('Redeem Token', '') || '');\nconst tokenMatches = storedToken.length > 0 && storedToken === request.token;\nconst isRedeemed = status.toLowerCase() === 'redeemed';\nconst isInvalidStatus = ['expired', 'invalid'].includes(status.toLowerCase());\nconst isExpired = expiresAt ? now.getTime() > expiresAt.getTime() : false;\n\nlet reason = '';\nlet message = '';\nlet canRedeem = true;\n\nif (!record.id) {\n  canRedeem = false;\n  reason = 'not_found';\n  message = 'Coupon non trovato.';\n} else if (!storedToken) {\n  canRedeem = false;\n  reason = 'missing_redeem_token_field';\n  message = 'Configurazione incompleta: nel record coupon manca il campo Redeem Token.';\n} else if (!tokenMatches) {\n  canRedeem = false;\n  reason = 'token_mismatch';\n  message = 'Token QR non valido per questo coupon.';\n} else if (isRedeemed) {\n  canRedeem = false;\n  reason = 'already_redeemed';\n  message = 'Coupon gia utilizzato' + (field('Redeemed At') ? ' il ' + field('Redeemed At') : '') + '.';\n} else if (isInvalidStatus) {\n  canRedeem = false;\n  reason = 'invalid_status';\n  message = 'Coupon non utilizzabile. Stato attuale: ' + status + '.';\n} else if (isExpired) {\n  canRedeem = false;\n  reason = 'expired';\n  message = 'Coupon scaduto.';\n} else if (!allowOutsidePromoForTest && (!isPromoDay || !isPromoHour)) {\n  canRedeem = false;\n  reason = 'outside_promo_window';\n  message = 'Promo attiva solo dal lunedi al giovedi, 18:30-22:30.';\n}\n\nif (canRedeem) {\n  reason = 'ok';\n  message = 'Coupon valido. Segnato come usato.';\n}\n\nreturn [{ json: {\n  ...record,\n  recordId: record.id,\n  code: request.code,\n  token: request.token,\n  storedTokenConfigured: storedToken ? 'true' : 'false',\n  tokenMatches: tokenMatches ? 'true' : 'false',\n  isConfirmRequest: request.isConfirmRequest,\n  pinOk: request.pinOk,\n  scannedAt: request.scannedAt,\n  scannedAtItaly: request.scannedAtItaly,\n  redeemedBy: request.redeemedBy,\n  canRedeem: canRedeem ? 'true' : 'false',\n  reason,\n  message,\n  status,\n  name: field('Name'),\n  email: field('Email'),\n  phone: field('Phone'),\n  couponCode: field('Coupon Code', request.code),\n  expiresAt: expiresAtRaw,\n  redeemedAt: field('Redeemed At'),\n  redeemAttempts,\n  redeemAttemptsNext: redeemAttempts + 1,\n  checkedWeekday: weekday,\n  checkedTime: String(hour).padStart(2, '0') + ':' + String(minute).padStart(2, '0'),\n} }];"
      },
